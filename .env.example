# Réglages du serveur Onyx, lus par docker-compose.yml.
# Copiez ce fichier en .env, puis remplissez-le : cp .env.example .env
#
# Les clés et les services se règlent aussi dans l'app (Paramètres → Serveur
# → Services) ; ce qui y est enregistré passe avant ce fichier.

# --- L'essentiel -------------------------------------------------------------

# Le dossier de vos médias sur cette machine (obligatoire). Rangez-y un
# sous-dossier par bibliothèque, par exemple Films/ et Séries/ : l'app les
# propose à la création d'une bibliothèque.
MEDIA_PATH=/chemin/vers/vos/medias

# ro : Onyx lit vos fichiers sans jamais les toucher.
# rw : Onyx peut aussi supprimer un titre depuis l'app.
MEDIA_ACCESS=ro

# Clé API TMDB, gratuite, pour les affiches, les résumés et les logos :
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# La langue des titres et des résumés (fr-FR, en-US…).
TMDB_LANGUAGE=fr-FR

# Votre fuseau horaire.
TZ=Europe/Paris

# --- Le conteneur ------------------------------------------------------------

# La version de l'image : latest, ou une version figée (v1.4, v1.4.2).
ONYX_VERSION=latest

# Le port de la machine où le serveur répond.
ONYX_PORT=8080

# Où garder la base, les sous-titres extraits et les aperçus.
ONYX_DATA=./data

# Faire tourner le serveur sous un compte sans privilèges plutôt que root.
# `id -u` et `id -g` donnent vos numéros ; sur Unraid, 99 et 100. Ce compte
# doit pouvoir lire MEDIA_PATH.
# PUID=1000
# PGID=1000

# --- Facultatif ----------------------------------------------------------------

# Fanart.tv : plus d'affiches au choix que celles de TMDB.
# FANART_API_KEY=

# Le service de demandes : mediahub, overseerr ou jellyseerr, son adresse et
# sa clé API.
# REQUEST_SERVICE=overseerr
# MEDIAHUB_URL=http://192.168.1.10:5055
# MEDIAHUB_API_KEY=

# Transcodage par le circuit vidéo (Intel, AMD) : auto, avec le bloc
# `devices` décommenté dans docker-compose.yml. Le journal dit l'encodeur pris.
# VIDEO_ENCODER=auto

# Le nombre de transcodages en même temps (par défaut, la moitié des cœurs,
# au moins 4 ; 0 retire la limite).
# MAX_TRANSCODES=4

# HTTPS sans proxy inverse (fichiers rangés dans le dossier des données). Sans
# HTTPS, mots de passe et jetons circulent en clair hors de chez vous.
# TLS_CERT_FILE=/app/data/tls/cert.pem
# TLS_KEY_FILE=/app/data/tls/key.pem

# Les proxys dont l'en-tête X-Forwarded-For est cru (par défaut, toute adresse
# locale ou privée). Nommez le vôtre : 172.18.0.2, ou none.
# TRUSTED_PROXIES=172.18.0.2

# La surveillance des dossiers : un fichier ajouté apparaît en quelques
# secondes. Sur un partage réseau (NFS, SMB), la vérification périodique
# rattrape ce que la surveillance ne voit pas ; 0 la coupe.
# LIBRARY_WATCH=true
# LIBRARY_POLL_INTERVAL=5m

# Le journal : debug, info, warn ou error ; text ou json.
# LOG_LEVEL=info
# LOG_FORMAT=text
